<Application x:Class="Depas.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Los mismos tonos que Revelado: negro, hueso y un solo color para lo nuevo. -->
        <SolidColorBrush x:Key="Fondo" Color="#0E0F0F"/>
        <SolidColorBrush x:Key="FondoAlto" Color="#151716"/>
        <SolidColorBrush x:Key="Tarjeta" Color="#191B1A"/>
        <SolidColorBrush x:Key="Linea" Color="#2F3331"/>
        <SolidColorBrush x:Key="Texto" Color="#F0F0EF"/>
        <SolidColorBrush x:Key="TextoSuave" Color="#A4A9A5"/>
        <SolidColorBrush x:Key="Nuevo" Color="#8FD6A0"/>
        <SolidColorBrush x:Key="Aviso" Color="#FF4D42"/>
        <!-- App.xaml.cs las cambia por las tipografías que viajan en recursos/fuentes. -->
        <FontFamily x:Key="Cuerpo">Segoe UI</FontFamily>
        <FontFamily x:Key="Mono">Consolas</FontFamily>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Tarjeta}"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Linea}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Caja" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource TextoSuave}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Caja" Property="Background" Value="{StaticResource Linea}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Texto}"/>
            <Setter Property="Foreground" Value="{StaticResource Fondo}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Texto}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <!-- Botón sin caja, para acciones secundarias dentro de las tarjetas y del panel. -->
        <Style x:Key="Enlace" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Contenido" Margin="0,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Texto}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Linea}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Caja" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource TextoSuave}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Caja" Property="Background" Value="{StaticResource Texto}"/>
                                <Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource Texto}"/>
                                <Setter Property="Foreground" Value="{StaticResource Fondo}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
            <Setter Property="Margin" Value="0,22,0,8"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Fondo}"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Linea}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Texto}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource TextoSuave}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource Linea}" CornerRadius="3" Margin="1,2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- El color del texto va explícito: si no, las tarjetas heredan el negro del tema de Windows. -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Caja" Background="{StaticResource Tarjeta}" BorderBrush="{StaticResource Linea}" BorderThickness="1" CornerRadius="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource TextoSuave}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
