<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Depas</AssemblyName>
    <RootNamespace>Depas</RootNamespace>
    <ApplicationIcon>recursos\depas.ico</ApplicationIcon>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Update="recursos\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
